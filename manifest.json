{
  "manifest_version": 3,
  "name": "Ensemble",
  "version": "0.1.0",
  "description": "Compose a purchasable look across Shopify stores: try it on, mix and match, add every piece to its cart.",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "Ensemble",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content/mcp-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*"],
      "js": ["content/detect.js", "content/overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
