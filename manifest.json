{
  "manifest_version": 3,
  "name": "Ensemble",
  "version": "0.1.0",
  "description": "Compose a purchasable look across Shopify stores: try it on, mix and match, add every piece to its cart.",
  "permissions": ["storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel/panel.html" },
  "action": { "default_title": "Ensemble" },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content/detect.js"],
      "run_at": "document_idle"
    }
  ]
}
